# Copy this file to .env and fill in real values.
# See README.md for how to get a free Postgres database (Neon) in ~2 minutes.

NODE_ENV=development
PORT=4000

# Postgres connection string. Get a free one at https://neon.tech
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=

# Optional: a SEPARATE database used only by `npm test`, so tests never touch
# your dev/demo data (tests truncate all tables before every test run).
# If omitted, tests fall back to using DATABASE_URL directly.
TEST_DATABASE_URL=

# Any long random string. Generate one with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-free single origin (or * for dev). Set to your deployed frontend URL in production.
CORS_ORIGIN=*

# Used to build links inside emails (e.g. the password reset link). Set this
# to your deployed frontend URL in production; defaults to the local Vite dev
# server otherwise.
FRONTEND_URL=http://localhost:5173

BCRYPT_ROUNDS=10

# Email (optional). If both GMAIL_USER and GMAIL_APP_PASSWORD are left blank,
# the app runs fine without sending any email — it just logs what it would
# have sent. To enable real email delivery via Gmail:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Paste the 16-character App Password below (NOT your real Gmail password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=SwiftShip Logistics
